              "path": [
                "books",
                "{{bookId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"0000000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
